# ============================================
# Конфигурационные переменные окружения core_it
# Создайте этот файл в корне проекта (не .env.example!)
# ============================================

# 🔐 СЕКРЕТЫ — замените на безопасные значения!

# Флаг секретного ключа для сессий
SECRET_KEY=your-secret-key-here  # ← ЗАМЕНИТЕ! Используйте: secrets.token_urlsafe(32)

# 📦 НАСТРОЙКИ БАЗЫ ДАННЫХ PostgreSQL

# URL подключения к PostgreSQL (формат: postgresql://user:password@host:port/database)
DATABASE_URL=postgresql://core_it_user:your_secure_password_here@localhost:5432/core_it_db

# Альтернативный вариант для docker-compose
# POSTGRES_USER=core_it_user
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_DB=core_it_db
# PGDATA=/var/lib/postgresql/data/pgdata

# 🌐 НАСТРОЙКИ СЕТИ (опционально)

# Бinds-адрес для Flask сервера (0.0.0.0 — доступ со всех интерфейсов, 127.0.0.1 — только локально)
FLASK_HOST=0.0.0.0

# Порт Flask приложения
FLASK_PORT=5000

# Режим разработки: development / production
FLASK_ENV=production

# 🔧 НАСТРОЙКИ ПРИЛОЖЕНИЯ

# Максимальный размер файла (по умолчанию: 200 МБ)
MAX_CONTENT_LENGTH_MB=200

# Таймаут для Gunicorn (в секундах)
GUNICORN_TIMEOUT=300

# Число воркеров Gunicorn (для продакшена увеличьте!)
GUNICORN_WORKERS=4

# 🚀 ПРОДВАКУРЕННЫЕ НАСТРОЙКИ (не включены по умолчанию)

# Включить логирование в структурированном формате
# STRUCTURED_LOGGING=true

# Включить кеширование результатов запросов (Redis, если установлен)
# REDIS_URL=redis://localhost:6379/0
